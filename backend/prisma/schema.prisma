generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  scheduled
  sending
  sent
  failed
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  googleId     String   @unique
  email        String   @unique
  name         String
  avatar       String?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  senders   Sender[]
  campaigns Campaign[]
  emails    Email[]
  slack     SlackConnection?
}

model Sender {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  email     String
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, email])
}

model Campaign {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  idempotencyKey String   @db.Uuid
  subject        String
  body           String
  bodyText       String
  // First ~200 characters of bodyText, so list rows never load full bodies.
  preview        String
  startAt        DateTime
  delayMs        Int
  hourlyLimit    Int
  total          Int
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, idempotencyKey])
}

model Email {
  id          String      @id @db.Uuid
  campaignId  String      @db.Uuid
  userId      String      @db.Uuid
  senderId    String      @db.Uuid
  to          String
  subject     String
  seq         Int
  scheduledAt DateTime
  sentAt      DateTime?
  status      EmailStatus @default(scheduled)
  claimedAt   DateTime?
  attempts    Int         @default(0)
  error       String?
  messageId   String?
  previewUrl  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([campaignId, to])
  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
}

model SlackConnection {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  teamId     String
  teamName   String
  channel    String
  webhookUrl String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
