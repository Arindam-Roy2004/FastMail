# ---- Server ----
NODE_ENV=development
PORT=4000
# The Vite dev server. CORS and the post-Slack redirect both point here.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Infrastructure (docker compose ports) ----
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5433/email_scheduler?schema=public
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9200

# ---- Sessions (generate with: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth (Web application client; needs the secret for the code flow) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Slack OAuth (app with the incoming-webhook scope) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must be HTTPS and listed in the Slack app's Redirect URLs, e.g. a tunnel to this API:
# https://<your-tunnel>.trycloudflare.com/api/slack/callback
SLACK_REDIRECT_URI=

# ---- Queue dashboard (Bull Board, read-only) ----
# Comma-separated emails allowed to open /admin/queues. Empty means nobody.
ADMIN_EMAILS=

# ---- Scheduler behaviour ----
# Parallel jobs per worker process. Different senders send in parallel; one
# sender is still held to MIN_DELAY_BETWEEN_EMAILS_MS.
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (provider throttling).
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hard ceiling per sender per clock hour. A campaign can only ask for less.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Upper bound on recipients in one schedule request.
MAX_RECIPIENTS_PER_REQUEST=5000
# How long a worker may hold a job before it counts as stalled.
JOB_LOCK_MS=60000
